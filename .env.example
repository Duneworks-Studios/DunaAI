# DunaAI — copy to .env and fill values

# Database (Supabase / Neon / Railway Postgres connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Auth.js — generate: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Legacy names (optional — mapped in src/instrumentation.ts for Netlify / older guides)
NEXTAUTH_SECRET=""
NEXTAUTH_URL=""
# Recommended behind Netlify / reverse proxies
AUTH_TRUST_HOST="true"

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Whop — company API key (server only; do not use NEXT_PUBLIC_)
WHOP_API_KEY=""
# Raw signing secret from Whop Developer → Webhooks (Standard Webhooks)
WHOP_WEBHOOK_SECRET=""
# Public checkout URLs (safe for client)
NEXT_PUBLIC_WHOP_CHECKOUT_MONTHLY=""
NEXT_PUBLIC_WHOP_CHECKOUT_LIFETIME=""
# Plan id that maps to DunaAI Enterprise (e.g. plan_...); other paid → Pro
WHOP_PLAN_ID_LIFETIME=""

# AI engine — Deepseek (OpenAI-compatible chat completions; server-only)
# Create a token: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""
# Optional: same token under the generic name (if you omit DEEPSEEK_API_KEY)
# DUNAAI_AI_API_KEY=""
# Optional: override URL (defaults to Deepseek when DEEPSEEK_API_KEY is set)
# DUNAAI_AI_ENDPOINT="https://api.deepseek.com/v1/chat/completions"
# Optional: chat model (defaults to deepseek-chat when unset)
DUNAAI_MODEL_CHAT=""
# Optional: coding model (defaults to DUNAAI_MODEL_CHAT, then deepseek-chat)
DUNAAI_MODEL_CODING=""

# Optional: transactional email for password reset (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="DunaAI <noreply@yourdomain.com>"

# Rate limiting (optional Upstash for multi-instance)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: seed admin password override
# SEED_ADMIN_PASSWORD=""
